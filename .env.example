# Database Connection
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/moonlight?retryWrites=true&w=majority"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Cloudflare R2 Storage (S3-Compatible for large photos, 4K/UHD videos)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="moonlight-media"
R2_PUBLIC_DOMAIN="https://pub-your_bucket.r2.dev"

# Admin Authentication & Security
ADMIN_EMAIL="admin@moonlightresort.com"
ADMIN_PASSWORD_HASH="$2b$10$exampleBcryptHashGeneratedForAdminPassword..."
AUTH_SECRET="your_generated_random_auth_secret_at_least_32_characters"

# Canonical Site URL
SITE_URL="https://moonlightresortstays.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Environment Control: production | staging | preview
# In staging or preview, robots.txt blocks all crawling (Disallow: /)
NEXT_PUBLIC_SITE_ENV="production"

# Google Search Console Verification (Optional Meta tag)
GOOGLE_SITE_VERIFICATION=""
